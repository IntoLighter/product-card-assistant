# Секреты. Скопируйте в .env и заполните при необходимости; .env в git не попадает.
# Публичные настройки — в .env.public, значение из .env их перекрывает.

# Нужен только для закрытых моделей Hugging Face
HF_TOKEN=
# Ключ облачной LLM; для локального vLLM не нужен (берётся LLM_API_KEY из .env.public)
# LLM_API_KEY=

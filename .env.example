# Скопируйте в .env при необходимости. Все значения необязательны — есть дефолты в docker-compose.yml

# --- vLLM ---
VLLM_IMAGE_TAG=v0.28.0
# Qwen3.5-4B, INT4 (W4A16, GPTQ) от RedHat под vLLM: ~5.5 ГБ весов
VLLM_MODEL=RedHatAI/Qwen3.5-4B-quantized.w4a16
VLLM_MAX_MODEL_LEN=6144
VLLM_GPU_MEMORY_UTILIZATION=0.85
# Параллельных запросов. У Qwen3.5 (гибрид с Mamba-слоями) каждому нужен блок кэша,
# а в 8 ГБ их помещается ~50 — дефолтные 256 vLLM не запустит. Генерируем по одной карточке.
VLLM_MAX_NUM_SEQS=8
VLLM_EXTRA_ARGS=--language-model-only        # не грузить vision-энкодер (экономия VRAM)

# Нехватка памяти (OOM) -> добавьте --enforce-eager и/или уменьшите VLLM_MAX_MODEL_LEN
# Для 12+ ГБ VRAM: VLLM_MODEL=RedHatAI/Qwen3.5-9B-quantized.w4a16
# Для текстовых (не мультимодальных) моделей, напр. Qwen/Qwen3-8B-AWQ: VLLM_EXTRA_ARGS=
HF_TOKEN=                                  # нужен только для закрытых моделей

# --- Приложение ---
LLM_MODEL=local-model                      # имя, под которым vLLM отдаёт модель
LLM_API_KEY=EMPTY                          # vLLM без --api-key ключ не проверяет
# LLM_BASE_URL=http://localhost:8000/v1    # для запуска app вне Docker
TEMPERATURE=0.3
SEED=42
REQUEST_TIMEOUT=120

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Отладка app в Docker",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/app",
          "remoteRoot": "/srv/app"
        }
      ],
    }
  ]
}

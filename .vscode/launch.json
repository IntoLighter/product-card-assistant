{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: примеры",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/cli.py",
      // Маску раскрывает сам CLI; результаты — в output/ (вне git), чтобы не менять examples/output
      "args": ["examples/*.json", "--out", "output", "--verbose"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // По умолчанию VS Code грузит .env в окружение, и его адрес vLLM (для Docker)
      // перекрыл бы .env.cli: переменные окружения важнее файлов
      "envFile": "${workspaceFolder}/.env.cli",
    },
    {
      "name": "Отладка app в Docker",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/app",
          "remoteRoot": "/srv/app"
        }
      ],
    }
  ]
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: примеры",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/cli.py",
      "args": ["examples/input/*.json", "--out", "ignore/output", "--verbose"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
    },
    {
      "name": "Отладка app в Docker",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/app",
          "remoteRoot": "/srv/app"
        }
      ],
    }
  ]
}

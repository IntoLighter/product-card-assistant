# Настройки — единственное место, где они заданы. Файл хранится в git.
# Ключи и токены сюда не пишите: они в .env.local (вне git, шаблон — .env.local.example).
# Значение из .env.local перекрывает значение отсюда.

# --- vLLM ---
# Qwen3.5-4B, INT4 (W4A16, GPTQ) от RedHat под vLLM: ~5.5 ГБ весов.
# Для 12+ ГБ VRAM: RedHatAI/Qwen3.5-9B-quantized.w4a16
VLLM_MODEL=RedHatAI/Qwen3.5-4B-quantized.w4a16
VLLM_MAX_MODEL_LEN=6144
# Нехватка памяти (OOM) -> уменьшите VLLM_MAX_MODEL_LEN или добавьте --enforce-eager
VLLM_GPU_MEMORY_UTILIZATION=0.85
# Параллельных запросов. У Qwen3.5 (гибрид с Mamba-слоями) каждому нужен блок кэша,
# а в 8 ГБ их помещается ~50 — дефолтные 256 vLLM не запустит
VLLM_MAX_NUM_SEQS=8
# Дополнительные флаги vLLM, например --enforce-eager при нехватке памяти
VLLM_EXTRA_ARGS=
# Xet-загрузчик Hugging Face в контейнере под WSL2 зависает — качаем обычным HTTPS
HF_HUB_DISABLE_XET=1

# --- Приложение ---
# Имя, под которым vLLM отдаёт модель
LLM_MODEL=local-model
# Адрес для запуска вне Docker; в Docker его заменяет docker-compose.yml
LLM_BASE_URL=http://localhost:8000/v1
# vLLM без --api-key ключ не проверяет, но SDK требует непустое значение.
# Настоящий ключ (облачная LLM) — в .env.local
LLM_API_KEY=EMPTY
TEMPERATURE=0.3
SEED=42
REQUEST_TIMEOUT=120
# Первая генерация и исправления по замечаниям проверки
MAX_ATTEMPTS=3

# --- Streamlit ---
# Перезапуск страницы при сохранении файла. Polling: из Windows через WSL2
# события файловой системы в контейнер не доходят
STREAMLIT_SERVER_RUN_ON_SAVE=true
STREAMLIT_SERVER_FILE_WATCHER_TYPE=poll
